# ===== 应用 =====
DEBUG=false
SECRET_KEY=please-change-me-to-a-random-string
ADMIN_TOKEN=change-me-admin-token
# MCP 端点（POST /mcp）的 Bearer 令牌；留空 = 不启用认证（仍受全局限流保护），公网部署建议设置
MCP_AUTH_TOKEN=

# ===== 数据库 =====
# 本地开发默认 SQLite；Docker Compose 中会自动注入 PostgreSQL 连接串
DATABASE_URL=sqlite:///./github_agent.db
# DATABASE_URL=postgresql+psycopg2://github_agent:github_agent@localhost:5432/github_agent

# ===== GitHub OAuth（https://github.com/settings/developers 创建 OAuth App）=====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

# 服务端访问令牌（可选）：定时任务用它把 API 限额从 60 次/小时提升到 5000 次/小时
GITHUB_TOKEN=

# ===== GitHub 检索 =====
# 支持 JSON 数组或逗号分隔
GITHUB_SEARCH_KEYWORDS=["machine learning", "web framework", "developer tools"]
# GITHUB_LANGUAGE=python
GITHUB_MIN_STARS=100
GITHUB_PER_PAGE=20
GITHUB_MAX_REPOS_PER_KEYWORD=20
GITHUB_MAX_ANALYZE_PER_RUN=30
# 匿名使用请保持 false（核心 API 仅 60 次/小时，README 抓取会迅速耗尽）；配置 GITHUB_TOKEN 后建议 true
GITHUB_FETCH_README=false

# ===== LLM 分析 =====
# 可选: deepseek | trained | openai | anthropic | local | rule
# deepseek = DeepSeek API（OpenAI 兼容，性价比高；无 embeddings API，向量检索仍走本地）
# trained = 本项目在 Windows 上训练的本地模型（零 API 成本，见 training/README.md）
LLM_PROVIDER=deepseek
# 主模型失败时的降级顺序（rule 永远可用，保证成功率）
LLM_FALLBACK_PROVIDERS=["trained","rule"]
# 本地训练模型的目录（训练产物，运行时完全离线）
TRAINED_MODEL_PATH=./models/repo-analyzer
OPENAI_API_KEY=
# OPENAI_BASE_URL=  # 兼容 OpenAI 协议的第三方/自建服务
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LOCAL_MODEL_PATH=microsoft/phi-2
# 推荐结果是否用重排（每次推荐增加延迟：llm 约 +1s、laya 约 +0.2s）
ENABLE_LLM_RERANK=false
# 重排器选择: llm（主分析器重排，生成推荐理由）| bge（本地 cross-encoder
# bge-reranker-v2-m3，零成本离线，BGE-M3 官方配套重排器，推荐）| laya（本地 421M
# 决策模型，实测区分度弱，实验性；均需 pip install -r requirements-ml.txt）
RERANK_PROVIDER=bge

# ===== 向量化 =====
# 可选: bge-m3 | trained | sentence_transformers | openai | tfidf（纯 Python 哈希 TF-IDF 兜底）
# bge-m3 = BAAI 多语言嵌入模型（1024 维，中文检索质量最佳；首次使用需下载 ~2.3GB，
#          换向量模型会自动清库重建索引，见 scripts/reindex_vectors.py）
# trained = 复用自训练模型的 encoder 做语义检索（中英文查询均可，零成本）
EMBEDDER_PROVIDER=bge-m3
# 主 embedder 不可用时的降级顺序（trained 缺模型时自动落到 tfidf）
EMBEDDER_FALLBACK_PROVIDERS=["trained","tfidf"]
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_MAX_LEN=1024
# OPENAI_EMBEDDING_API_KEY=  # 留空则复用 OPENAI_API_KEY

# ===== 向量数据库 =====
# 可选: chroma | memory（chromadb 未安装或初始化失败时自动回退 memory）
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=project_embeddings

# ===== 问题研究（POST /api/research 与 MCP research_problem）=====
# 多路检索 + DeepSeek 规划/分类，成本较高，结果按问题哈希缓存
RESEARCH_MAX_CANDIDATES=40
RESEARCH_CACHE_HOURS=24
# GitHub 搜索的最低星标（低于主索引的 GITHUB_MIN_STARS，用于捞新兴项目）
RESEARCH_MIN_STARS=30
RESEARCH_KEYWORDS=4

# ===== 定时任务 / 7x24 自主循环 =====
SCHEDULER_ENABLED=true
FETCH_INTERVAL_MINUTES=1440
REFRESH_INTERVAL_MINUTES=360
REFRESH_BATCH_SIZE=50
# 每次定时检索消耗关键词列表的下一片并轮换（0=每次全量）；7x24 运行建议 8-16
KEYWORDS_PER_FETCH=0
# 巡检：短周期自愈循环（处理积压分析/重试失败/修复向量漂移）
PATROL_ENABLED=true
PATROL_INTERVAL_MINUTES=10
PATROL_REQUEUE_FAILED=true
PATROL_RECONCILE_VECTORS=true
PATROL_RECONCILE_LIMIT=2000
# 并行分析线程数（分析阶段吃满空闲 CPU；1-4 合理）
ANALYSIS_WORKERS=2

# ===== 安全 =====
# 用于加密存储用户 GitHub token 的 Fernet 密钥（base64），留空则由 SECRET_KEY 派生
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# ===== Redis（可选）=====
# 留空 = 全部基础设施用进程内默认实现（限流内存计数、文件锁、内存缓存），零额外服务
# 设置后 = 限流窗口/作业锁/研究缓存变为跨进程共享且重启不丢（多 worker/多机部署时启用）
#REDIS_URL=redis://localhost:6379/0

# ===== 语音（全离线，需先运行 python training/download_speech_models.py）=====
# 语音识别（faster-whisper small, CPU int8）；设为 none 可禁用
ASR_PROVIDER=faster_whisper
ASR_MODEL_PATH=./models/whisper-small
ASR_COMPUTE_TYPE=int8
# ASR_LANGUAGE=zh  # 留空自动检测中英文
# 语音合成（sherpa-onnx + Melo-TTS 中英混读）；设为 none 可禁用
TTS_PROVIDER=sherpa_onnx
TTS_MODEL_DIR=./models/tts-melo-zh-en
TTS_SPEED=1.0
# 语音回答最多播报几个项目
VOICE_REPLY_MAX_RESULTS=3

# ===== 自进化（无人值守 重训/门禁/晋升/回滚）=====
EVOLUTION_ENABLED=true
EVOLUTION_INTERVAL_MINUTES=1440
EVOLUTION_TRAIN_EPOCHS=2
# 距上一版新增样本不足此数则跳过重训
EVOLUTION_MIN_NEW_SAMPLES=200
EVOLUTION_MAX_TRAIN_SAMPLES=12000
EVOLUTION_MIN_TOPIC_FREQ=40
# 晋升后立刻用新模型空间重建的向量数上限（其余由巡检完成）
EVOLUTION_MAX_REEMBED=500

# ===== 反馈闭环（外部点赞/点踩真实影响行为）=====
FEEDBACK_IN_RANKING=true
FEEDBACK_PENALTY_WEIGHT=0.25
FEEDBACK_UPVOTE_BONUS=0.10
# 被踩 >= 阈值的项目由巡检自动重分析
PATROL_REQUEUE_DOWNVOTE_THRESHOLD=2
# 零结果查询由 Gap Scout 扩展为检索关键词并轮换
GAP_SCOUT_ENABLED=true
GAP_SCOUT_INTERVAL_MINUTES=60
DYNAMIC_KEYWORD_LIMIT=8

# ===== 通知（patrol/进化失败、模型晋升/回滚时推送）=====
# 自动识别格式：企业微信机器人 / ServerChan / Telegram / 通用 JSON；留空禁用
NOTIFY_WEBHOOK_URL=
# NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_MINUTES=30

# ===== 每日备份（SQLite + chroma 目录，轮转保留）=====
BACKUP_ENABLED=true
BACKUP_HOUR_UTC=19
BACKUP_RETENTION=7
BACKUP_DIR=./backups
